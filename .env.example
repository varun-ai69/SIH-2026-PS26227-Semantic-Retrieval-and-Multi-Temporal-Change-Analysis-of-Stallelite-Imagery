# ==============================================================================
# CANOPUS System Environment Variables (.env.example)
# Copy this file to .env to customize local or production settings.
# When running with Docker Compose, all defaults work out of the box with zero changes!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Application & Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=canopus_strategic_dgis_secret_key_change_in_prod

# ------------------------------------------------------------------------------
# 2. PostgreSQL + PostGIS (Metadata, Spatial Lineage & Chat Persistence)
# ------------------------------------------------------------------------------
# Inside Docker container: POSTGRES_HOST=postgres, POSTGRES_PORT=5432
# Running Python on host machine outside Docker: POSTGRES_HOST=localhost, POSTGRES_PORT=5434
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eo_archive
POSTGRES_USER=eo_admin
POSTGRES_PASSWORD=eo_password
DATABASE_URL=postgresql://eo_admin:eo_password@postgres:5432/eo_archive

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Database (RemoteCLIP 512-D High-Dimensional Vector Space)
# ------------------------------------------------------------------------------
# Inside Docker container: QDRANT_HOST=qdrant
# Running Python on host machine outside Docker: QDRANT_HOST=localhost
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=tile_embeddings
QDRANT_MAXAR_COLLECTION=maxar_tile_embeddings

# ------------------------------------------------------------------------------
# 4. MinIO Object Storage (S3-Compatible GeoTIFF & Asset Storage)
# ------------------------------------------------------------------------------
# Inside Docker container: MINIO_ENDPOINT=minio:9000
# Running on host machine: MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=eo_admin
MINIO_ROOT_PASSWORD=eo_password
MINIO_ACCESS_KEY=eo_admin
MINIO_SECRET_KEY=eo_password

# ------------------------------------------------------------------------------
# 5. Deep Learning Model & Device Configuration
# ------------------------------------------------------------------------------
# Set to 'cpu' for standard CPU execution or 'cuda' for NVIDIA GPU acceleration
DEVICE=cpu
REMOTECLIP_CHECKPOINT_PATH=./models/retrieval/RemoteCLIP-ViT-B-32.pt

# Sovereign Defense & Offline Operation Flags
# By default on fresh clones, set to 'false' and 0 so HuggingFace can download model weights automatically.
# Toggle to 'true' and 1 for strict air-gapped defense operation once weights are cached in ./models/.
OFFLINE_MODE=false
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ------------------------------------------------------------------------------
# 6. Storage Directories
# ------------------------------------------------------------------------------
DATA_DIR=./data
MODELS_DIR=./models
